# Tool state and credentials (wrangler keeps OAuth tokens here)
.wrangler
.copilot
1Password
homebrew
notion
# zsh-abbr creates its user abbreviations file at load; ours are
# session-only and declared in Nix (nix/home/tools/zsh-abbr.nix)
zsh-abbr
# Zed writes databases here (prompts/, ...); track only the settings
zed/*
!zed/settings.json
!zed/keymap.json
!zed/tasks.json
!zed/snippets/
!zed/themes/
# herdr runtime state; only config.toml is settings
herdr/*
!herdr/config.toml

# Generated by home-manager (links into /nix/store)
zsh/env.zsh
zsh/human.zsh
direnv/lib/hm-nix-direnv.sh

# hunk: last-seen version, rewritten on every run
hunk/state.json
