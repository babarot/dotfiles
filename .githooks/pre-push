#!/bin/sh
# Builds both Macs' configurations before a push that changes Nix files,
# so a change for the work Mac is known to build before that Mac pulls
# it. CI only evaluates them (.github/workflows/nix.yaml); building here
# reuses the local store and sees the real agent-skills. It builds the
# pushed commit, not the working tree.
set -eu

zero=0000000000000000000000000000000000000000
top=$(git rev-parse --show-toplevel)

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one per ref
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: compare with where it left main
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -n "$base" ] && ! git diff --name-only "$base" "$local_sha" |
    grep -Eq '^(flake\.(nix|lock)$|nix/|home/skills/)'; then
    continue
  fi
  flake="git+file://$top?rev=$local_sha"
  # Every Mac in the flake, so a new host needs no change here
  hosts=$(nix eval --raw "$flake#darwinConfigurations" \
    --apply 'c: builtins.concatStringsSep " " (builtins.attrNames c)')
  for host in $hosts; do
    echo "pre-push: building $host at ${local_sha%"${local_sha#???????}"}" >&2
    if ! nix build --no-link "$flake#darwinConfigurations.$host.system"; then
      echo "pre-push: $host does not build; fix it before pushing" >&2
      exit 1
    fi
  done
done
