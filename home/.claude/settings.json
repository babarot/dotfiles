{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "true"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(poetry:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)",
      "Bash(pip3:*)",
      "Bash(pipx:*)",
      "Bash(pip:*)",
      "Bash(sudo:*)",
      "Read(~/.ssh/**)",
      "Read(**/.env)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/babarot/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/c-c-statusline\""
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "core@babarot-skills": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "work@babarot-skills": true
  },
  "extraKnownMarketplaces": {
    "babarot-skills": {
      "source": {
        "source": "github",
        "repo": "babarot/agent-skills"
      },
      "autoUpdate": true
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
