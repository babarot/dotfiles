.wrangler
1Password
homebrew
notion
# zsh-abbr creates its user abbreviations file at load; ours are
# session-only and declared in Nix (nix/home-manager/tools/zsh-abbr.nix)
zsh-abbr
# herdr runtime state; only config.toml and reviewr's config are settings
herdr/*
!herdr/config.toml
!herdr/plugins/
herdr/plugins/*
!herdr/plugins/config/
herdr/plugins/config/*
!herdr/plugins/config/persiyanov.reviewr/
herdr/plugins/config/persiyanov.reviewr/*
!herdr/plugins/config/persiyanov.reviewr/config.toml

# Generated by home-manager (links into /nix/store)
zsh/ai.zsh
zsh/env.zsh
zsh/human.zsh
git/tools.gitconfig
direnv/lib/hm-nix-direnv.sh
mise/config.toml

# hunk: last-seen version, rewritten on every run
hunk/state.json

