# herdr runtime state; only config.toml and reviewr's config are settings
herdr/*
!herdr/config.toml
!herdr/plugins/
herdr/plugins/*
!herdr/plugins/config/
herdr/plugins/config/*
!herdr/plugins/config/persiyanov.reviewr/
herdr/plugins/config/persiyanov.reviewr/*
!herdr/plugins/config/persiyanov.reviewr/config.toml

