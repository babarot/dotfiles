short:-G	long:--ghq	desc:Show ghq path	func:ghq list --full-path	condition:which ghq
short:-g	long:--git	desc:Show dirs managed by Git	func:git rev-parse --show-toplevel; fd --type directory --hidden --exclude .git --absolute-path . "$(git rev-parse --show-toplevel)" | sort	condition:which fd && git rev-parse --is-inside-work-tree
short:-x	long:	desc:Show favorite dirs	func:cat ~/.config/enhancd/*.fav | sort | uniq | xargs -I% sh -c 'echo %'	condition:
