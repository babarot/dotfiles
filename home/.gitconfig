[github]
  user = babarot

[core]
  editor = nvim
  excludesfile = ~/.gitignore
  preloadindex = true
  pager = less
	quotePath = false

[color]
  ui = auto

[color "diff"]
  meta = 242 238
  frag = 239 236
  old = 167 normal
  new = 030 normal
  context = 240
  commit = 246 024
  # meta = yellow bold
  # frag = magenta bold
  # old = red bold
  # new = green bold
  # whitespace = red reverse

[alias]
  st = status
  co = checkout
  ci = commit
  wt = worktree
  br = switch
  lo = log --color=always --max-count=15 --oneline
  ll  = lla --first-parent
  lla = "log --graph --date=human --format='%C(#e3c78a)%h%C(#ff5454)%d%C(reset) - %C(#36c692)(%ad)%C(reset) %s %C(#80a0ff){%an}%C(reset)'"
  graph = log --graph --date-order --all --pretty=format:'%h %Cred%d %Cgreen%ad %Cblue%cn %Creset%s' --date=short
  unadd = restore --staged
  review = diff origin/HEAD...
  rvf = diff origin/HEAD... --name-only
  rvc = log --oneline ...origin/HEAD
  typechange = !git status -s | awk '$1==\"T\"{print $2}' | xargs git checkout
  delete-merged-branches = !git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
  branch-log = log --oneline HEAD --not main
  blog = log --oneline HEAD --not origin/main

  ; Worktree commands
  ;
  ; land and sync run from a linked worktree and move main in the main
  ; worktree for it (git will not move a branch checked out elsewhere).
  ;
  ; land: in a repo that takes no PRs, put this branch's commits in main.
  ; Local only unless --push (-p) is given. It is the same as:
  ;   1. git pull --ff-only origin main    (in the main worktree)
  ;   2. git rebase main                   (in this worktree)
  ;   3. git merge --ff-only <branch>      (in the main worktree; like
  ;                                         "Rebase and merge" on a PR)
  ;   4. git push origin main              (with --push only)
  ;
  ; sync: in a repo that takes PRs, bring what others merged into this
  ; branch. It never pushes. It is the same as:
  ;   1. git fetch origin main
  ;   2. git merge --ff-only origin/main   (in the main worktree)
  ;   3. git rebase origin/main            (in this worktree)
  ;   4. git push --force-with-lease       (by hand, if the branch was
  ;                                         pushed; sync says when)
  ;
  ; Shell aliases get this worktree's GIT_DIR, which would win over -C, so
  ; both drop it first
  land = "!f() { \
    unset GIT_DIR GIT_WORK_TREE; \
    push=; \
    case ${1-} in \
      '') ;; \
      -p|--push) push=1 ;; \
      *) echo \"usage: git land [--push]\" >&2; return 2 ;; \
    esac; \
    m=$(git symbolic-ref -q --short refs/remotes/origin/HEAD); m=${m#origin/}; m=${m:-main}; \
    b=$(git branch --show-current); \
    root=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
    [ -n \"$b\" ] && [ \"$b\" != \"$m\" ] || { echo \"land: not on a branch other than $m\" >&2; return 1; }; \
    [ \"$(git -C \"$root\" branch --show-current)\" = \"$m\" ] || { echo \"land: $root is not on $m\" >&2; return 1; }; \
    git -C \"$root\" pull -q --ff-only origin \"$m\" && \
    git rebase \"$m\" && \
    git -C \"$root\" merge -q --ff-only \"$b\" && \
    git -C \"$root\" log --oneline -1 && \
    if [ -n \"$push\" ]; then git -C \"$root\" push -q origin \"$m\"; fi; \
  }; f"
  sync = "!f() { \
    unset GIT_DIR GIT_WORK_TREE; \
    m=$(git symbolic-ref -q --short refs/remotes/origin/HEAD); m=${m#origin/}; m=${m:-main}; \
    b=$(git branch --show-current); \
    root=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
    git fetch -q origin \"$m\" || return 1; \
    if [ \"$(git -C \"$root\" branch --show-current)\" = \"$m\" ]; then \
      git -C \"$root\" merge -q --ff-only \"origin/$m\" || echo \"sync: could not fast-forward $m in $root\" >&2; \
    fi; \
    [ -n \"$b\" ] && [ \"$b\" != \"$m\" ] || return 0; \
    git rebase \"origin/$m\" || return 1; \
    if git rev-parse -q --verify '@{push}' >/dev/null && ! git merge-base --is-ancestor '@{push}' HEAD; then \
      echo \"sync: $b was rebased; push with: git push --force-with-lease\" >&2; \
    fi; \
  }; f"

  df = diff --no-ext-diff

[help]
  autocorrect = 1

[user]
  name = babarot
  email = b4b4r07@gmail.com
	signingkey = /Users/babarot/.ssh/id_rsa.pub

[pager]
  branch = less -X

[diff]
  tool                = nvimdiff
  algorithm           = histogram

[init]
  defaultBranch = main

[merge]
  tool = nvimdiff

[commit]
	gpgsign = true
  template = ~/.gitmessage

[push]
	default = current
	autoSetupRemote = true

[tag]
  gpgsign = false

[gpg]
	format = ssh

[url "https://"]
  insteadOf = git://

[url "ssh://git@github.com/"]
  insteadOf = https://github.com/

[url "ssh://git@ssh.github.com:443/"]
	insteadOf = git@github.com:

# The dotfiles repo's own hooks (.githooks), for its main checkout and
# every worktree (their git dirs live under .git/worktrees)
[includeIf "gitdir:~/src/github.com/babarot/dotfiles/"]
  path = ~/.config/git/dotfiles-repo.gitconfig

[ghq]
  root = ~/src
  user = babarot

[sequence]
  editor = nvim

# Settings that belong to a tool (ov as the pager, the dft alias), written
# with store paths in its nix/home-manager/tools/<tool>.nix (my.gitConfig).
# Last, so they win over anything above
[include]
  path = ~/.config/git/tools.gitconfig
