From: babarot <b4b4r07@gmail.com>
Date: Wed, 30 Sep 2026 16:26:12 +0900
Subject: [PATCH 1/4] Add H and L to collapse and expand every group

Only h and l on the current repository or organisation exist, so
folding a long list took one key per group.
---
 src/state/mod.rs          | 18 ++++++++++++++++++
 src/ui/app.rs             |  2 ++
 src/ui/components/help.rs |  4 ++++
 3 files changed, 24 insertions(+)

diff --git a/src/state/mod.rs b/src/state/mod.rs
index 2e817d7..972d81a 100644
--- a/src/state/mod.rs
+++ b/src/state/mod.rs
@@ -403,6 +403,24 @@ impl AppState {
         }
     }
 
+    /// Collapse or expand every repository and organisation at once.
+    pub fn set_all_expanded(&mut self, expanded: bool) {
+        if expanded {
+            self.expanded_repos.clear();
+            self.expanded_orgs.clear();
+        } else {
+            self.collapse_all_repos();
+            for n in &self.notifications {
+                self.expanded_orgs
+                    .insert(n.repository.owner.login.clone(), false);
+            }
+        }
+        self.build_tree();
+        if !self.tree_items.is_empty() {
+            self.selected_index = self.selected_index.min(self.tree_items.len() - 1);
+        }
+    }
+
     pub fn selected_notification(&self) -> Option<&Notification> {
         self.tree_items
             .get(self.selected_index)
diff --git a/src/ui/app.rs b/src/ui/app.rs
index dfc935d..fae1f46 100644
--- a/src/ui/app.rs
+++ b/src/ui/app.rs
@@ -3134,6 +3134,8 @@ impl App {
                     self.state.toggle_repo_expansion(&repo_name);
                 }
             }
+            KeyCode::Char('H') => self.state.set_all_expanded(false),
+            KeyCode::Char('L') => self.state.set_all_expanded(true),
             KeyCode::Left | KeyCode::Char('h') => {
                 // Collapse org if on an org header
                 if let Some(org_name) = self.state.selected_org() {
