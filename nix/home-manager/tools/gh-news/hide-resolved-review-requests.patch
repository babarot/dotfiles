+    pub fn is_resolved_review_request(&self) -> bool {
+        self.reason_enum() == NotificationReason::ReviewRequested
+            && self.notification_type() == NotificationType::PullRequest
+            && matches!(
+                self.context.as_deref(),
+                Some("merged" | "closed" | "approved")
+            )
+    }
