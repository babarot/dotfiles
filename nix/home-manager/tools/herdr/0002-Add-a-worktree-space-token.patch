 src/config/sidebar.rs                         |  3 ++
 src/protocol/wire.rs                          |  3 ++
 src/server/client_shell.rs                    |  8 ++++
 src/ui/sidebar/tokens.rs                      |  8 ++++
 8 files changed, 77 insertions(+)

