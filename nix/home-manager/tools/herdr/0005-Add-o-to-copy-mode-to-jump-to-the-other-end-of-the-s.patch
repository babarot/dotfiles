From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: babarot <b4b4r07@gmail.com>
Date: Tue, 6 Oct 2026 22:32:28 +0900
Subject: [PATCH] Add o to copy mode to jump to the other end of the selection

Copy mode had no way to move the start of a selection once it was made:
the anchor stays where v, Space or V was pressed, and only the cursor
end moves. In tmux's and Vim's vi keys, o swaps the cursor with the
other end, so either end can be adjusted.

o now swaps the cursor and the selection anchor. With a linewise
selection (V) it swaps the rows and keeps the cursor's column. Without
a selection it does nothing.
---
 src/client/shell/copy_mode.rs  | 18 +++++++++
 src/client/shell/tests/copy.rs | 71 ++++++++++++++++++++++++++++++++++
 2 files changed, 89 insertions(+)

diff --git a/src/client/shell/copy_mode.rs b/src/client/shell/copy_mode.rs
index be5b63e..d5e9cd4 100644
--- a/src/client/shell/copy_mode.rs
+++ b/src/client/shell/copy_mode.rs
@@ -211,6 +211,7 @@ impl ClientShellState {
             }
             'v' | ' ' => self.begin_copy_selection(false),
             'V' => self.begin_copy_selection(true),
+            'o' => self.swap_copy_selection_ends(outcome),
             'h' => self.move_copy_cursor(0, -1, outcome),
             'j' => self.move_copy_cursor(1, 0, outcome),
             'k' => self.move_copy_cursor(-1, 0, outcome),
@@ -667,6 +668,23 @@ impl ClientShellState {
         }
     }
 
+    fn swap_copy_selection_ends(&mut self, outcome: &mut ClientShellInput) {
+        let Some(copy_mode) = self.copy_mode.as_mut() else {
+            return;
+        };
+        match copy_mode.selection.as_mut() {
+            Some(ClientCopySelection::Character { anchor }) => {
+                std::mem::swap(anchor, &mut copy_mode.cursor);
+            }
+            Some(ClientCopySelection::Linewise { anchor_row }) => {
+                std::mem::swap(anchor_row, &mut copy_mode.cursor.row);
+            }
+            None => return,
+        }
+        self.reveal_copy_cursor(outcome, false);
+        self.sync_copy_selection();
+    }
+
     pub(super) fn sync_copy_selection(&mut self) {
         let Some(copy_mode) = self.copy_mode.as_ref() else {
             return;
